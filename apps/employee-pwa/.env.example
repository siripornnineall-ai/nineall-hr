# Nineall HR — employee-pwa environment variables
# Copy into .env.local. This app only ever uses the public anon key —
# it never needs the service-role key (that's admin-web's job).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3011
