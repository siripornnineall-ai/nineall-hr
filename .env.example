# ============================================================================
# Nineall HR — environment variables
# Copy the relevant lines into apps/admin-web/.env.local and
# apps/employee-mobile/.env. Never commit real values.
# ============================================================================

# --- Supabase (shared by admin-web and employee-mobile) ---------------------
# Find these in Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Service role key — SERVER-SIDE ONLY. Used by admin-web server actions to
# create employee login accounts. Never expose this to the browser or mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- admin-web (Next.js) -----------------------------------------------------
# Base URL of the deployed admin site, used to build password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- employee-mobile (Expo) --------------------------------------------------
# Expo only exposes EXPO_PUBLIC_* variables to the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
